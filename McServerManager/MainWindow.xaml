<Window x:Class="McServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:McServerManager"
        mc:Ignorable="d"
        Title="Minecraft Server Manager" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Status"
                   Grid.Row="0"
                   Text="Status: Idle"
                   FontSize="24"
                   Margin="0,0,0,20" />

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="RAM Allocation"
                       FontSize="18"
                       Margin="0,0,0,8" />

            <Slider x:Name="RamSlider"
                    Minimum="1"
                    Maximum="16"
                    Value="4"
                    Width="250"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="RamSlider_ValueChanged" />

            <TextBlock x:Name="RamLabel"
                       Text="4 GB"
                       Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">
            <Button x:Name="StartServerButton"
                    Content="Start Server"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="RUnJavaAndDoyouthingy" />
            <Button x:Name="StopServerButton"
                    Content="Stop Server"
                    Width="100"
                    Click="PleaseStopTheServer" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal">
            <TextBox x:Name="ServerFolderTextBox"
                     Width="300"
                     Height="30"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Text="No folder selected" />
            <Button Content="Choose Folder"
                    Width="120"
                    Height="35"
                    Click="ChooseFolder_Click" />
        </StackPanel>
    </Grid>
</Window>
